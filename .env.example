# Application environment: local | test | production
APP_ENV=local

# Execution plane: TEST | PRODUCTION
EXECUTION_ENV=TEST

# Backend
API_HOST=127.0.0.1
API_PORT=8081
DATABASE_URL=postgres://sales_agent:sales_agent_local@127.0.0.1:5432/sales_agent?sslmode=disable
REDIS_URL=redis://127.0.0.1:6379/0

# Exact browser origin used for Origin/CSRF validation.
APP_ORIGIN=http://127.0.0.1:3000

# Temporary Milestone 01 switch. The API refuses to start with this enabled
# unless APP_ENV=local. Keep false in every shared or production environment.
AUTH_OTP_BYPASS=false
AUTH_SESSION_TTL=8h

# Only connections from these controlled reverse-proxy networks may supply a
# client IP through X-Forwarded-For. Loopback covers the local Next.js rewrite.
AUTH_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Frontend
# Server-only Next.js rewrite destination. Browser code always calls /api/* on
# the Next.js origin; this value is never exposed as a NEXT_PUBLIC variable.
GO_API_ORIGIN=http://127.0.0.1:8081

# Local object storage (to be enabled after infrastructure bootstrap)
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_BUCKET_TEST=sales-agent-test
OBJECT_STORAGE_BUCKET_PRODUCTION=sales-agent-production
OBJECT_STORAGE_ACCESS_KEY=REPLACE_LOCAL_ONLY
OBJECT_STORAGE_SECRET_KEY=REPLACE_LOCAL_ONLY

# Never place real production provider credentials in local .env files.
# Core/provider secret references will be resolved through the SecretReference abstraction.
