# Application environment: local | test | production
APP_ENV=local

# Execution plane: TEST | PRODUCTION
EXECUTION_ENV=TEST

# Backend
API_HOST=127.0.0.1
API_PORT=8081
DATABASE_URL=postgres://sales_agent:sales_agent_local@127.0.0.1:5432/sales_agent?sslmode=disable
REDIS_URL=redis://127.0.0.1:6379/0

# Exact browser origin used for Origin/CSRF validation.
APP_ORIGIN=http://127.0.0.1:3001

# Local developer bypass. The API refuses to start with this enabled unless
# APP_ENV=local. Keep false in every shared or production environment.
AUTH_OTP_BYPASS=false
AUTH_SESSION_TTL=8h

# Required whenever AUTH_OTP_BYPASS=false. Generate at least 32 random bytes,
# for example with: openssl rand -base64 32
# Replace this placeholder locally. Production injects the value from managed
# secret storage; it must never be committed or logged.
AUTH_OTP_HMAC_SECRET=REPLACE_WITH_BASE64_ENCODED_RANDOM_32_BYTE_SECRET

# Authentication email. Mailpit is accepted only in APP_ENV=local|test and is
# fixed to plaintext, unauthenticated loopback SMTP on 127.0.0.1:1025.
# APP_ENV=test requires mailpit. APP_ENV=production requires smtp, TLS, and
# non-empty provider credentials.
AUTH_EMAIL_MODE=mailpit
AUTH_EMAIL_FROM_ADDRESS=no-reply@sales-agent.local
AUTH_EMAIL_FROM_NAME="Sales Agent"
AUTH_SMTP_HOST=127.0.0.1
AUTH_SMTP_PORT=1025
AUTH_SMTP_TLS_MODE=none
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_TIMEOUT=10s

# Only connections from these controlled reverse-proxy networks may supply a
# client IP through X-Forwarded-For. Loopback covers the local Next.js rewrite.
AUTH_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Frontend
# Server-only Next.js rewrite destination. Browser code always calls /api/* on
# the Next.js origin; this value is never exposed as a NEXT_PUBLIC variable.
GO_API_ORIGIN=http://127.0.0.1:8081

# Local object storage (to be enabled after infrastructure bootstrap)
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_BUCKET_TEST=sales-agent-test
OBJECT_STORAGE_BUCKET_PRODUCTION=sales-agent-production
OBJECT_STORAGE_ACCESS_KEY=REPLACE_LOCAL_ONLY
OBJECT_STORAGE_SECRET_KEY=REPLACE_LOCAL_ONLY

# Never place real production provider credentials in local .env files.
# OTP HMAC and SMTP secrets are deployment-injected environment values in this
# milestone and must move behind the SecretReference/managed-secret abstraction
# during production deployment hardening.
