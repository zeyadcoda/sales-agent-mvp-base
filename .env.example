# Application environment: local | test | production
APP_ENV=local

# Execution plane: TEST | PRODUCTION
EXECUTION_ENV=TEST

# Backend
API_HOST=127.0.0.1
API_PORT=8081
DATABASE_URL=postgres://sales_agent:sales_agent_local@127.0.0.1:5432/sales_agent?sslmode=disable
REDIS_URL=redis://127.0.0.1:6379/0

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8081/api/v1

# Local object storage (to be enabled after infrastructure bootstrap)
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_BUCKET_TEST=sales-agent-test
OBJECT_STORAGE_BUCKET_PRODUCTION=sales-agent-production
OBJECT_STORAGE_ACCESS_KEY=REPLACE_LOCAL_ONLY
OBJECT_STORAGE_SECRET_KEY=REPLACE_LOCAL_ONLY

# Never place real production provider credentials in local .env files.
# Core/provider secret references will be resolved through the SecretReference abstraction.
